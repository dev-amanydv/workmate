# ==============================================================================
# Workmate Production Environment Configuration
# Copy this file to .env.production on your EC2 instance before deploying:
#   cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# DOMAIN & PUBLIC ACCESS (Leave empty or set to :80 if using raw EC2 IP initially)
# ------------------------------------------------------------------------------
# Set to your domain (e.g., workmate.amanydv.in) for automatic HTTPS via Caddy.
# If testing without a domain (using IP only), leave DOMAIN empty.
DOMAIN=

# ------------------------------------------------------------------------------
# MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
MYSQL_DATABASE=workmate
MYSQL_USER=workmate
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password

# ------------------------------------------------------------------------------
# BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Frontend URL (Used for CORS and cookie origin matching)
# Example with domain: https://workmate.amanydv.in
# Example with IP: http://<YOUR_EC2_PUBLIC_IP>
FRONTEND_URL=http://localhost

# Cookie configuration
# Set COOKIE_SAME_SITE=lax for same-domain deployment (recommended)
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# JWT Secrets (Generate secure 32+ character random strings)
JWT_ACCESS_SECRET=generate_a_random_32_character_secret_here
JWT_REFRESH_SECRET=generate_another_random_32_character_secret_here
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Google OAuth 2.0 (From Google Cloud Console)
# Ensure GOOGLE_CALLBACK_URL matches the authorized redirect URI in Google Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# Cloudflare R2 Storage (Optional: if empty or left as default, local upload fallback is used)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=workmate
R2_PUBLIC_URL=https://pub-workmate.r2.dev

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# In production with Caddy reverse proxy on same domain/host:
# NEXT_PUBLIC_API_URL can be relative ("/api") or full ("https://yourdomain.com/api")
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=
