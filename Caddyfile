{
    # Global options
    admin off
}

# If DOMAIN is set (e.g. workmate.amanydv.in), Caddy automatically provisions HTTPS.
# If DOMAIN is omitted, it defaults to HTTP on port 80.
{$DOMAIN::80} {
    encode zstd gzip

    # Backend API routes
    handle /api/* {
        reverse_proxy backend:4000
    }

    # Socket.IO WebSocket routes
    handle /socket.io/* {
        reverse_proxy backend:4000
    }

    # Backend Health Check
    handle /health {
        reverse_proxy backend:4000
    }

    # Backend uploads (for local storage fallback)
    handle /uploads/* {
        reverse_proxy backend:4000
    }

    # Frontend routes (Next.js)
    handle {
        reverse_proxy web:3000
    }
}
