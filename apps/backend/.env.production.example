# ==============================================================================
# Workmate Backend Production Environment Configuration
# Save as: apps/backend/.env.production or apps/backend/.env
# ==============================================================================

# Server configuration
NODE_ENV=production
PORT=4000

# MySQL Database
MYSQL_DATABASE=workmate
MYSQL_USER=workmate
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password
DATABASE_URL=mysql://workmate:change_this_to_a_strong_password@mysql:3306/workmate

# Frontend Application URL (e.g. https://workmate.amanydv.in or https://your-app.vercel.app)
# Required for CORS and credentials/cookie handling
FRONTEND_URL=https://workmate.amanydv.in

# Cookie Settings
# Use 'none' if frontend and backend are on different domains/subdomains with HTTPS
# Use 'lax' if on the same domain
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# JWT Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=generate_a_random_32_character_secret_here
JWT_REFRESH_SECRET=generate_another_random_32_character_secret_here
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Example: https://api.yourdomain.com/api/auth/google/callback or http://<EC2_IP>:4000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Cloudflare R2 Storage (Optional: if placeholder, local file storage fallback is used)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=workmate
R2_PUBLIC_URL=https://pub-workmate.r2.dev

# Local storage fallback settings
UPLOADS_DIR=./uploads
LOCAL_STORAGE_BASE_URL=http://localhost:4000
